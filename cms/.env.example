APP_NAME="iNi ViE CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Defaults target the Docker path, which is the verified one.
# `mysql` is the Compose service name.
#
# Running against your own MySQL instead? Change this one line to
# 127.0.0.1. Nothing else differs. See docs/TECHNICAL-DESIGN.md ch. 2.4.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inivie
DB_USERNAME=inivie
DB_PASSWORD=secret

# Host port Compose publishes MySQL on. Change it if 3306 is already taken.
FORWARD_DB_PORT=3306

# The single origin allowed to call /api/v1. Never a wildcard:
# production pins https://inivie.com. See docs/API-SPEC.md ch. 5.1.
FRONTEND_URL=http://localhost:3000

# Where this application reaches that frontend to post the callback. Not the
# same thing as FRONTEND_URL above, and the difference only shows up in
# Docker: that one is the origin a browser presents and CORS compares as a
# string, this one is an address this process opens a socket to, and inside
# the container the frontend is not on localhost. `host.docker.internal` is
# the host machine as seen from the container.
#
# Running natively? Change this one to http://localhost:3000 as well. It and
# DB_HOST are the two lines that differ between the setup paths.
FRONTEND_INTERNAL_URL=http://host.docker.internal:3000

# Shared secret for that callback, sent as X-Revalidate-Secret and matched by
# the frontend. The same value has to be in web/.env, and this local default
# is in both .env.example files so a fresh clone works without a step.
#
# Leave it empty to turn revalidation off: the homepage then catches up on its
# own 60 second cache window instead. A real deployment generates its own.
REVALIDATE_SECRET=local-development-revalidate-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Property images. Local disk here, swappable to object storage without a
# code change. See docs/TECHNICAL-DESIGN.md ch. 5.5.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
