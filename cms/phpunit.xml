<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned so the derived image_url and the CORS origin do not depend
             on whatever a developer happens to have in .env. -->
        <env name="APP_URL" value="http://localhost:8000"/>
        <env name="FILESYSTEM_DISK" value="public"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="FRONTEND_INTERNAL_URL" value="http://localhost:3000"/>
        <!-- Empty on purpose, which turns revalidation off for the suite. A
             developer's .env carries the working local secret, and without
             this pin every test that saves a property would post to whatever
             is listening on port 3000. The cases that cover the callback set
             it for themselves and fake the client. -->
        <env name="REVALIDATE_SECRET" value=""/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
