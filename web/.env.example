# ---------------------------------------------------------------------------
# Where the Laravel CMS answers.
#
# Read on the server only, so it carries no NEXT_PUBLIC_ prefix and never
# reaches a browser bundle: the API is called from Server Components and does
# not need to be publicly reachable (API-SPEC ch. 7).
# ---------------------------------------------------------------------------
CMS_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# The host serving property images, allowlisted for next/image.
#
# A host, not a URL. Local disk today, a CDN or bucket after the move
# described in TECHNICAL-DESIGN ch. 5.5, which is a change to this line and
# nothing else.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MEDIA_HOST=localhost:8000
