# ---------------------------------------------------------------------------
# Where the Laravel CMS answers.
#
# Read on the server only, so it carries no NEXT_PUBLIC_ prefix and never
# reaches a browser bundle: the API is called from Server Components and does
# not need to be publicly reachable (API-SPEC ch. 7).
# ---------------------------------------------------------------------------
CMS_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# The host serving property images, allowlisted for next/image.
#
# A host, not a URL. Local disk today, a CDN or bucket after the move
# described in TECHNICAL-DESIGN ch. 5.5, which is a change to this line and
# nothing else.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MEDIA_HOST=localhost:8000

# ---------------------------------------------------------------------------
# Shared secret for the cache invalidation callback the CMS posts to
# /api/revalidate after an edit (API-SPEC ch. 5.2).
#
# The same value has to be in cms/.env. No default ships in either file,
# because requirement S4 in docs/PRD.md ch. 8.5 is that no secret lives in
# version control, and one published in a public repository is not a secret.
# No NEXT_PUBLIC_ prefix either, for the obvious reason.
#
# Left empty, the route refuses every caller with a 401: the homepage then
# catches up on its own 60 second cache window instead.
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Where this site answers, as an origin.
#
# The canonical URL, the Open Graph URLs, robots.txt and sitemap.xml are all
# built from this one value (PRD ch. 8.3), so they cannot disagree about where
# the site lives. Read on the server only, so no NEXT_PUBLIC_ prefix.
#
# Left unset it falls back to http://localhost:3000, which is correct for
# local development. Set to something that is not a URL, it refuses the
# build: a typo here would otherwise ship a canonical, a sitemap and a
# sharing card all pointing at localhost, with nothing saying so.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
